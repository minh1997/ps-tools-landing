---
import "../styles/global.css";

const creditPlans = [
  { credits: "200", price: "300K", benefits: ["Phù hợp dùng thử", "Đầy đủ tính năng", "Không giới hạn thời gian"] },
  { credits: "400", price: "580K", benefits: ["Phù hợp cá nhân", "Đầy đủ tính năng", "Không giới hạn thời gian"] },
  { credits: "800", price: "1.100K", benefits: ["Phù hợp studio nhỏ", "Đầy đủ tính năng", "Không giới hạn thời gian"] },
  { credits: "1.000", price: "1.300K", popular: true, benefits: ["Phù hợp studio", "Tiết kiệm chi phí", "Đầy đủ tính năng", "Không giới hạn thời gian"] },
  { credits: "2.000", price: "2.500K", benefits: ["Phù hợp studio lớn", "Hiệu quả chi phí cao nhất", "Đầy đủ tính năng", "Không giới hạn thời gian"] },
];
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#07111d" />
    <meta name="description" content="PS Visual Tool — Bộ công cụ AI thực hoá phông nền, ánh sáng và hiệu ứng dành cho nhiếp ảnh gia." />
    <meta property="og:title" content="PS Visual Tool — Nâng tầm cao cho phông nền" />
    <meta property="og:description" content="Biến phông nền tĩnh thành bối cảnh chân thực chỉ với một cú nhấp." />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="vi_VN" />
    <link rel="preload" href="/assets/ps-studio-hero-ui.webp" as="image" type="image/webp" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%2307111d'/%3E%3Cpath d='M32 8 52 20v24L32 56 12 44V20L32 8Zm0 5.7L17 22.5v18.9l15 8.9 15-8.9V22.5l-15-8.8ZM18.5 26 32 34l13.5-8v5.7L35 38v10h-6V38l-10.5-6.3V26Z' fill='%23dcecff'/%3E%3C/svg%3E" />
    <title>PS Visual Tool — Nâng tầm cao cho phông nền</title>
  </head>
  <body>
    <div class="noise" aria-hidden="true"></div>
    <header class="site-header" id="top">
      <div class="container nav-shell">
        <a class="brand" href="#top" aria-label="PS Visual Tool — về trang chủ">
          <svg class="brand-mark" viewBox="0 0 54 54" aria-hidden="true"><path d="M27 3 48 15v24L27 51 6 39V15L27 3Z" /><path d="m9 17 18 10 18-10M9 29l18 10 18-10M27 27v24" /><path d="m17 22 10-6 10 6" /></svg>
          <span class="brand-name"><b>P &amp; S</b><i>Visual Tool</i></span>
        </a>
        <nav class="desktop-nav" aria-label="Điều hướng chính">
          <a class="active" href="#top">Trang chủ</a><a href="#tinh-nang">Tính năng</a><a href="#bang-gia">Bảng giá</a><a href="#huong-dan">Hướng dẫn</a><a href="#lien-he">Liên hệ</a>
        </nav>
        <div class="nav-actions"><span class="version">V1.0.1</span><button class="menu-toggle" type="button" aria-label="Mở menu" aria-expanded="false"><span></span><span></span></button></div>
      </div>
      <nav class="mobile-nav" aria-label="Điều hướng di động"><a href="#top">Trang chủ</a><a href="#tinh-nang">Tính năng</a><a href="#bang-gia">Bảng giá</a><a href="#huong-dan">Hướng dẫn</a><a href="#lien-he">Liên hệ</a></nav>
    </header>

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-image" aria-hidden="true"></div><div class="hero-shade" aria-hidden="true"></div>
        <div class="container hero-inner">
          <div class="hero-copy">
            <div class="eyebrow">Phần mềm chuyên cho nhiếp ảnh</div>
            <h1 id="hero-title">PS Visual Tool</h1>
            <h2>Nâng tầm cao cho phông nền</h2>
            <p class="hero-lead">Biến phông nền tĩnh thành bối cảnh chân thực chỉ với 1 cú click, cùng nhiều hiệu ứng mạnh mẽ giúp bức ảnh có chiều sâu, tự nhiên và chuyên nghiệp hơn. Không thay đổi nhân vật, makeup và màu sắc gốc.</p>
            <ul class="hero-benefits">
              <li><span>✓</span> Thao tác 1 click, nhanh và chính xác</li><li><span>✓</span> Giữ nguyên chi tiết và bố cục gốc</li><li><span>✓</span> Bối cảnh chân thực, chi tiết và có chiều sâu</li><li><span>✓</span> Nhiều hiệu ứng chuyên nghiệp cho ảnh phông</li>
            </ul>
            <a class="download-button download-trigger" href="/downloads/PS_V1.0.1.ccx" download="PS_V1.0.1.ccx" id="tai-xuong"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v11m0 0 4-4m-4 4-4-4M5 15v4h14v-4" /></svg><strong>Tải ngay PS Visual Tool</strong><span>›</span></a>
            <div class="platform-note"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5.6 10.4 4v7H3V5.6Zm8.4-1.8L21 2v9h-9.6V3.8ZM3 12h7.4v7L3 17.4V12Zm8.4 0H21v10l-9.6-1.9V12Z" /></svg><span class="apple">●</span><span>Hỗ trợ Windows &amp; Mac</span><i></i><span>Yêu cầu Photoshop 27 trở lên</span></div>
          </div>
        </div>
      </section>

      <section class="tools" id="tinh-nang" aria-labelledby="tools-title">
        <div class="container">
          <div class="section-heading"><div class="heading-kicker"><span></span> Tính năng nổi bật <span></span></div><h2 id="tools-title">Bộ công cụ thực hoá phông nền &amp; hiệu ứng AI</h2><p>Đầy đủ công cụ chuyên sâu, thao tác đơn giản, cho ra bối cảnh chân thực và giàu cảm xúc</p></div>
          <div class="tool-grid">
            <article class="tool-card"><div class="tool-icon magic">✦</div><div><h3>Thực hoá tự động</h3><p>Biến bối cảnh trở nên sống động</p></div><b>›</b></article>
            <article class="tool-card"><div class="tool-icon mountain">▲</div><div><h3>Thực hoá phông nền chân thực</h3><p>Tạo bối cảnh tự nhiên, chi tiết, sâu không gian</p></div><b>›</b></article>
            <article class="tool-card"><div class="tool-icon sun">☀</div><div><h3>Thực hoá ánh sáng trái</h3><p>Tạo ánh sáng tự nhiên từ bên trái</p></div><b>›</b></article>
            <article class="tool-card"><div class="tool-icon sun">☀</div><div><h3>Thực hoá ánh sáng phải</h3><p>Tạo ánh sáng tự nhiên từ bên phải</p></div><b>›</b></article>
            <article class="tool-card"><div class="tool-icon rim">◒</div><div><h3>Thực hoá chiếu sáng sau</h3><p>Tạo ánh sáng ngược, viền sáng, chiều sâu</p></div><b>›</b></article>
            <article class="tool-card"><div class="tool-icon cloud">☁</div><div><h3>Thực hoá tạo bóng đổ</h3><p>Tạo bóng cây, tường, vật thể tự nhiên</p></div><b>›</b></article>
            <article class="tool-card"><div class="tool-icon leaf">◈</div><div><h3>Thực hoá nền cỏ thật</h3><p>Tạo cỏ tự nhiên, chi tiết, đa dạng</p></div><b>›</b></article>
            <article class="tool-card"><div class="tool-icon layers">▰</div><div><h3>Thực hoá nền sỏi</h3><p>Tạo nền sỏi chi tiết, đa dạng, chân thực</p></div><b>›</b></article>
            <article class="tool-card"><div class="tool-icon waves">≋</div><div><h3>Thực hoá nền cát</h3><p>Tạo bề mặt cát tự nhiên, có chiều sâu</p></div><b>›</b></article>
            <article class="tool-card"><div class="tool-icon palette">●</div><div><h3>Thực hoá màu không gian</h3><p>Đồng bộ màu sắc, ánh sáng, không gian</p></div><b>›</b></article>
            <article class="tool-card"><div class="tool-icon magic">✦</div><div><h3>Hiệu ứng AI</h3><p>Chọn hiệu ứng muốn thêm vào ảnh</p></div><b>›</b></article>
            <article class="tool-card"><div class="tool-icon snow">❄</div><div><h3>Thêm tuyết rơi</h3><p>Tạo tuyết rơi tự nhiên theo chiều sâu không gian</p></div><b>›</b></article>
            <article class="tool-card"><div class="tool-icon mist">≈</div><div><h3>Thêm sương tự nhiên</h3><p>Tạo lớp sương mềm với chiều sâu chân thực</p></div><b>›</b></article>
            <article class="tool-card"><div class="tool-icon flower">❦</div><div><h3>Thêm cánh hoa</h3><p>Thêm cánh hoa mềm mại, tự nhiên và có chiều sâu</p></div><b>›</b></article>
            <article class="tool-card"><div class="tool-icon leaf">◈</div><div><h3>Thêm lá rơi</h3><p>Thêm lá rơi tự nhiên theo chuyển động và không gian</p></div><b>›</b></article>
          </div>
        </div>
      </section>

      <section class="pricing" id="bang-gia" aria-labelledby="pricing-title">
        <div class="pricing-glow" aria-hidden="true"></div>
        <div class="container pricing-inner">
          <div class="section-heading pricing-heading">
            <div class="heading-kicker"><span></span> Bảng giá <span></span></div>
            <h2 id="pricing-title">Bảng giá gói <em>Credit</em></h2>
            <p>Chọn số credit phù hợp với nhu cầu chỉnh sửa ảnh của bạn</p>
          </div>
          <div class="price-grid">
            {creditPlans.map((plan) => (
              <article class:list={["price-card", { popular: plan.popular }]}>
                {plan.popular && <div class="popular-badge"><span>♛</span> Phổ biến nhất</div>}
                <div class="credit-mark" aria-hidden="true"><i></i><i></i><i></i></div>
                <div class="credit-amount">{plan.credits}</div>
                <div class="credit-label">Credit</div>
                <div class="price-box"><strong>{plan.price}</strong><span>VND</span></div>
                <ul class="price-benefits">
                  {plan.benefits.map((benefit) => <li><span>✓</span>{benefit}</li>)}
                </ul>
                <a class="price-action" href="#lien-he" aria-label={`Mua gói ${plan.credits} credit`}>Mua ngay</a>
              </article>
            ))}
          </div>
          <p class="pricing-note"><span>✓</span> Credit không giới hạn thời gian sử dụng và áp dụng cho toàn bộ tính năng PS Visual Tool.</p>
        </div>
      </section>

      <section class="install-guide" id="huong-dan" aria-labelledby="guide-title">
        <div class="container">
          <div class="guide-intro">
            <div class="section-heading guide-heading"><div class="heading-kicker"><span></span> Hướng dẫn cài đặt <span></span></div><h2 id="guide-title">Cài PS Visual Tool cho Photoshop</h2><p>Cài trực tiếp từ file <strong>.ccx</strong> đã tải xuống qua Adobe Creative Cloud</p></div>
            <aside class="guide-ready" aria-label="Yêu cầu trước khi cài đặt"><div class="guide-ready-icon">27+</div><div><strong>Yêu cầu Photoshop 27.0 trở lên</strong><p>Cài Adobe Creative Cloud Desktop, đăng nhập tài khoản Adobe và đóng Photoshop trước khi cài plugin.</p></div></aside>
          </div>
          <div class="install-columns">
            <article class="install-panel windows">
              <div class="platform-title"><span class="platform-symbol" aria-hidden="true">⊞</span><div><p>Windows</p><h3>Cài đặt trên Windows</h3></div></div>
              <ol class="install-steps">
                <li><b>01</b><div><strong>Tải file cài đặt</strong><p>Nhấn “Tải ngay PS Visual Tool” và chờ file <code>PS_V1.0.1.ccx</code> xuất hiện trong thư mục Downloads.</p></div></li>
                <li><b>02</b><div><strong>Mở file .ccx</strong><p>Nháy đúp file vừa tải. Adobe Creative Cloud sẽ mở trình cài đặt plugin.</p></div></li>
                <li><b>03</b><div><strong>Xác nhận cài đặt</strong><p>Làm theo thông báo của Creative Cloud cho đến khi quá trình hoàn tất.</p></div></li>
                <li><b>04</b><div><strong>Mở trong Photoshop</strong><p>Khởi động Photoshop 27 trở lên, vào menu <em>Plugins</em> và chọn <em>PS Tools V1</em>.</p></div></li>
              </ol>
              <div class="install-tip"><strong>Không mở được file?</strong><span>Nhấp phải file → <em>Open with</em> → chọn <em>Unified Plugin Installer Agent</em> trong Adobe Desktop Common.</span></div>
            </article>
            <article class="install-panel macos">
              <div class="platform-title"><span class="platform-symbol apple-symbol" aria-hidden="true">●</span><div><p>macOS</p><h3>Cài đặt trên macOS</h3></div></div>
              <ol class="install-steps">
                <li><b>01</b><div><strong>Tải file cài đặt</strong><p>Nhấn “Tải ngay PS Visual Tool”. File <code>PS_V1.0.1.ccx</code> thường nằm trong Downloads.</p></div></li>
                <li><b>02</b><div><strong>Mở bằng Creative Cloud</strong><p>Nháy đúp file <code>.ccx</code> để Creative Cloud bắt đầu cài plugin.</p></div></li>
                <li><b>03</b><div><strong>Cho phép khi được hỏi</strong><p>Nếu macOS yêu cầu quyền, hãy xác nhận bằng mật khẩu quản trị viên của máy.</p></div></li>
                <li><b>04</b><div><strong>Kiểm tra trong Photoshop</strong><p>Mở Photoshop 27 trở lên, vào menu <em>Plugins</em> và chọn <em>PS Tools V1</em>.</p></div></li>
              </ol>
              <div class="install-tip"><strong>File không tự mở?</strong><span>Nhấp phải → <em>Open With</em> → chọn <em>Unified Plugin Installer Agent</em> của Adobe Creative Cloud.</span></div>
            </article>
          </div>
          <div class="guide-result">
            <div class="guide-result-copy"><span class="guide-result-kicker">Sau khi cài đặt</span><h3>Kiểm tra bảng công cụ</h3><p>Trong Photoshop, mở <strong>Plugins → PS Tools V1</strong>. Khi bảng công cụ giống hình bên cạnh xuất hiện, plugin đã sẵn sàng để sử dụng.</p><p class="guide-result-note">Ảnh minh họa lấy từ giao diện PS Tools V1 của bạn.</p></div>
            <a class="guide-result-image" href="/assets/ps-tools-guide.webp" target="_blank" rel="noopener" aria-label="Xem ảnh giao diện PS Tools V1 kích thước đầy đủ"><img src="/assets/ps-tools-guide.webp" width="750" height="1141" loading="lazy" alt="Bảng công cụ PS Tools V1 sau khi mở trong Photoshop" /><span>Xem ảnh lớn ↗</span></a>
          </div>
          <div class="guide-help"><div><span>?</span><p><strong>Đã cài nhưng không thấy plugin?</strong> Kiểm tra Photoshop đang dùng phiên bản 27.0 trở lên, thoát hẳn Photoshop và Creative Cloud, rồi mở lại cả hai ứng dụng.</p></div><a class="download-trigger" href="/downloads/PS_V1.0.1.ccx" download="PS_V1.0.1.ccx">Tải lại file .ccx</a></div>
        </div>
      </section>
    </main>

    <footer id="lien-he"><div class="container footer-inner"><a class="brand" href="#top" aria-label="PS Visual Tool — về trang chủ"><svg class="brand-mark" viewBox="0 0 54 54" aria-hidden="true"><path d="M27 3 48 15v24L27 51 6 39V15L27 3Z" /><path d="m9 17 18 10 18-10M9 29l18 10 18-10M27 27v24" /><path d="m17 22 10-6 10 6" /></svg><span class="brand-name"><b>P &amp; S</b><i>Visual Tool</i></span></a><div class="credit-line"></div><p>Developed by<br /><strong>Anh Sơn &amp; Phó KT</strong></p></div></footer>
    <div class="toast" role="status" aria-live="polite" aria-hidden="true"><span>✓</span><div><strong>Đang tải PS Visual Tool</strong><p>File cài đặt .ccx đã bắt đầu tải xuống.</p></div><button type="button" aria-label="Đóng thông báo">×</button></div>
    <script src="../scripts/app.js"></script>
  </body>
</html>
