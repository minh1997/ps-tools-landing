{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ps-visual-tool",
  "main": "./src/worker.js",
  "compatibility_date": "2026-10-05",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/v1/payments/packages/*"],
    "not_found_handling": "single-page-application"
  }
}
