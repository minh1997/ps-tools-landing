{
  "name": "ps-visual-tool-landing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/check-build.mjs",
    "package:windows": "node scripts/package-windows.mjs",
